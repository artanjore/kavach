KAVACH_ENV=prod                      # "dev" returns OTPs in responses and never sends WhatsApp
DATABASE_URL=postgresql+psycopg://kavach:***@db.internal:5432/kavach   # India region (Mumbai)
ADMIN_TOKEN=change-me

# WhatsApp Cloud API (Meta Business verification required)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=                 # enables webhook signature checks - set it in production
WHATSAPP_ALERT_TEMPLATE=kavach_guardian_alert   # approved UTILITY template, one body param {{1}}

# LLM second opinion for the message checker (optional; rules work without it)
ANTHROPIC_API_KEY=
KAVACH_LLM_MODEL=claude-opus-5-5

# Bank partners (v2): "BANKCODE:api-key,OTHERBANK:api-key"
BANK_API_KEYS=
HOLD_DECISION_MINUTES=60
GUARDIAN_COOLOFF_HOURS=24
